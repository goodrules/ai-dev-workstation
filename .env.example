# ==============================================================================
# GCP Cloud Workstations Environment Configuration Example
# Copy this file to .env and customize with your own settings:
#   cp .env.example .env
# ==============================================================================

# Google Cloud Project ID where Cloud Workstations will be provisioned
# Required if not configured in active gcloud CLI context
PROJECT_ID="my-gcp-project-id"

# Google Cloud Region for the Workstation Cluster and Config
# Default: us-central1
REGION="us-central1"

# Workstation Cluster Identifier (must match ^[a-z][a-z0-9-]{0,62}$)
# If empty or omitted, setup.sh discovers existing clusters or prompts to create one
CLUSTER_ID="dev-cluster"

# Workstation Configuration Identifier (must match ^[a-z][a-z0-9-]{0,62}$)
# If empty or omitted, setup.sh discovers existing configs or prompts to create one
CONFIG_ID="dev-config"

# Workstation Instance Identifier (must match ^[a-z][a-z0-9-]{0,62}$)
# If empty or omitted, setup.sh derives this from USER_EMAIL (e.g., ws-developer)
WORKSTATION_ID="my-workstation"

# Workstation User IAM Principal (grant roles/workstations.user)
# Required if not configured in active gcloud CLI context
USER_EMAIL="developer@example.com"

# Automation & Execution Controls
# Set to true (or 1) to run non-interactively using defaults and env vars
NON_INTERACTIVE=false

# Set to true (or 1) to simulate actions and Terraform execution without provisioning
DRY_RUN=false
